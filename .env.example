# Copy to .env (never commit .env). Loaded by scripts/serve.py.
DATABASE_PATH=data/arthsetu.db
MODELS_DIR=models
# Set true when served over HTTPS (REQUIRED in production so the session cookie is Secure)
COOKIE_SECURE=false
SESSION_TTL_HOURS=12
SESSION_IDLE_MINUTES=120
RATE_LIMITS_ENABLED=true
# Only if the frontend is hosted on a different origin, e.g. https://app.example.com
ALLOWED_ORIGINS=
# Set true only behind a trusted reverse proxy that sets X-Forwarded-For
TRUSTED_PROXY=false
# Groq assistant (server-side only). Choose a currently supported model id from https://console.groq.com/docs/models
GROQ_API_KEY=
GROQ_MODEL=
